{
  "name": "code-cleaner-by-siddarthsbalaji",
  "displayName": "CodeCleaner",
  "description": "Minifies, cleans up, and refactors code within the editor.",
  "version": "4.0.0",
  "publisher": "SiddarthSBalaji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SidTheSloth12/code-cleaner-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:code-cleaner.cleanCode",
    "onCommand:code-cleaner.cleanSelection",
    "onCommand:code-cleaner.cleanFile",
    "onCommand:code-cleaner.cleanWithProfile",
    "onCommand:code-cleaner.cleanWithPreview",
    "onCommand:code-cleaner.cleanFileFromExplorer",
    "onCommand:code-cleaner.switchProfile",
    "onCommand:code-cleaner.cleanFolder"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodeCleaner",
      "properties": {
        "codeCleaner.profile": {
          "type": "string",
          "scope": "language-overridable",
          "enum": [
            "Format",
            "Clean",
            "Minify",
            "Obfuscate"
          ],
          "enumDescriptions": [
            "Safely standardizes spacing and indentation without removing comments or blank lines.",
            "Balanced cleanup (default): removes comments, blank lines, and tightens operators while keeping structure.",
            "Aggressively removes all unnecessary whitespace, empty lines, and indentation for minimal file size.",
            "Mangles identifier names and removes console.log statements (JavaScript only)."
          ],
          "markdownEnumDescriptions": [
            "**Format**: Safely standardizes spacing and indentation. Preserves all comments, blank lines, and code structure.",
            "**Clean** *(Default)*: Balanced tidy. Removes comments, empty lines, and tightens operator spacing while preserving readable indentation.",
            "**Minify**: Aggressive compression. Strips all unnecessary whitespace, blank lines, and indentation.",
            "**Obfuscate**: Mangles variable names and drops `console.log` statements (JavaScript only)."
          ],
          "default": "Clean",
          "description": "Default profile used when cleaning code."
        },
        "codeCleaner.removeComments": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": true,
          "description": "If enabled, comments will be removed when cleaning code."
        },
        "codeCleaner.removeBlankLines": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": true,
          "description": "If enabled, blank lines will be removed."
        },
        "codeCleaner.removeSpacesAroundOperators": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": true,
          "description": "If enabled, spaces around operators will be removed."
        },
        "codeCleaner.removeIndentation": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": false,
          "description": "If enabled, indentation will be removed."
        },
        "codeCleaner.cleanOnSave": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": false,
          "description": "If enabled, code will be automatically cleaned when the file is saved."
        },
        "codeCleaner.preserveLegalHeaders": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": true,
          "description": "If enabled, copyright notices, license banners (/*!, //! , @license), and SPDX identifiers are preserved even when removing comments."
        },
        "codeCleaner.preserveDocstrings": {
          "type": "boolean",
          "scope": "language-overridable",
          "default": false,
          "description": "If enabled, JSDoc and API documentation comments (/** ... */) are preserved."
        }
      }
    },
    "commands": [
      {
        "command": "code-cleaner.cleanCode",
        "title": "CodeCleaner: Clean",
        "shortTitle": "Clean"
      },
      {
        "command": "code-cleaner.cleanSelection",
        "title": "CodeCleaner: Clean Selection",
        "shortTitle": "Clean Selection"
      },
      {
        "command": "code-cleaner.cleanFile",
        "title": "CodeCleaner: Clean File",
        "shortTitle": "Clean File"
      },
      {
        "command": "code-cleaner.cleanWithProfile",
        "title": "CodeCleaner: Clean with Profile...",
        "shortTitle": "Clean with Profile..."
      },
      {
        "command": "code-cleaner.cleanWithPreview",
        "title": "CodeCleaner: Clean with Preview (Diff)",
        "shortTitle": "Preview Clean (Diff)"
      },
      {
        "command": "code-cleaner.cleanFileFromExplorer",
        "title": "CodeCleaner: Clean File",
        "shortTitle": "Clean File"
      },
      {
        "command": "code-cleaner.cleanFolder",
        "title": "CodeCleaner: Clean Folder",
        "shortTitle": "Clean Folder"
      },
      {
        "command": "code-cleaner.switchProfile",
        "title": "CodeCleaner: Switch Default Profile...",
        "shortTitle": "Switch Default Profile..."
      }
    ],
    "keybindings": [
      {
        "command": "code-cleaner.cleanCode",
        "key": "alt+shift+c",
        "mac": "alt+shift+c",
        "when": "editorTextFocus"
      }
    ],
    "submenus": [
      {
        "id": "code-cleaner.editorSubmenu",
        "label": "CodeCleaner",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "code-cleaner.editorSubmenu",
          "group": "modification"
        }
      ],
      "code-cleaner.editorSubmenu": [
        {
          "command": "code-cleaner.cleanSelection",
          "group": "1_clean@1",
          "when": "editorHasSelection"
        },
        {
          "command": "code-cleaner.cleanFile",
          "group": "1_clean@1",
          "when": "!editorHasSelection"
        },
        {
          "command": "code-cleaner.cleanWithProfile",
          "group": "1_clean@2"
        },
        {
          "command": "code-cleaner.cleanWithPreview",
          "group": "1_clean@3"
        },
        {
          "command": "code-cleaner.switchProfile",
          "group": "2_config@1"
        }
      ],
      "explorer/context": [
        {
          "command": "code-cleaner.cleanFolder",
          "group": "modification@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "code-cleaner.cleanFileFromExplorer",
          "group": "modification@2",
          "when": "!explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run esbuild-base",
    "watch": "npm run esbuild-base -- --watch",
    "package": "npm run esbuild-base -- --minify",
    "esbuild-base": "node esbuild.js",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node ./out/test/runTest.js",
    "test:unit": "npm run compile && mocha out/test/unit/cleaner.test.js"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/emscripten": "^1.41.5",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/test-electron": "^2.3.8",
    "chai": "^4.4.1",
    "esbuild": "^0.19.11",
    "eslint": "^8.57.1",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "terser": "^5.27.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  }
}